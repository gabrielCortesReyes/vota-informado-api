# Base de datos (solo para usuarios). Sin esto se usa SQLite local (vota_informado.db).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vota_informado
# O bien por partes (Cloud SQL: PGSQL_HOSTNAME=/cloudsql/proyecto:region:instancia)
# PGSQL_HOSTNAME=
# PGSQL_PORT=5432
# PGSQL_USERNAME=
# PGSQL_PASSWORD=
# PGSQL_DBNAME=vota_informado

# JWT. Genera una clave: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=cambia-esta-clave
APP_ACCESS_TOKEN_EXPIRE=60
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# API de la Cámara
CACHE_TTL_SECONDS=3600
CAMARA_TIMEOUT_SECONDS=30

# WhatsApp para recuperar contraseña (opcional)
WPP_ENDPOINT=
WPP_TOKEN=

# Padrón de parlamentarios
SENADO_SENADORES_URL=https://tramitacion.senado.cl/wspublico/senadores_vigentes.php
# Wikimedia pide identificar la app con una URL o correo de contacto del proyecto
WIKIPEDIA_USER_AGENT=VotaInformado/3.0 (https://tu-sitio.cl)
