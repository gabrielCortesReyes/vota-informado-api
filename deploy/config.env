# Configuración del despliegue de Vota Informado en Google Cloud.
# Revisa estos valores antes de correr los scripts (todos los scripts leen este archivo).

# Cuenta de Google con la que se despliega (gcloud auth login)
GCP_ACCOUNT="gabriel@softmind.cl"
# ID del proyecto de GCP (debe existir y tener facturación activa)
PROJECT_ID="vota-informado-513922"
REGION="us-central1"

SERVICE="vota-informado"            # servicio de Cloud Run (la API)
SYNC_JOB="vota-informado-sync"      # job de Cloud Run que sincroniza el padrón
REPO="vota-informado"               # repositorio de Artifact Registry
SQL_INSTANCE="vota-inteligente-db"  # instancia de Cloud SQL (ya creada; setup-gcp.sh no la toca)
SQL_REGION="us-east1"               # región de la instancia (Cloud Run queda en REGION)
SQL_TIER="db-f1-micro"              # la más barata (núcleo compartido, 0,6 GB RAM)
DB_NAME="vota_informado"
DB_USER="vota_informado"
RUNTIME_SA="vota-informado-run"     # cuenta de servicio con que corren la API y el job
SCHEDULER_SA="vota-informado-scheduler"
DEPLOYER_SA="vota-informado-deployer"   # cuenta que usa GitHub Actions para desplegar

# Repositorio de GitHub (dueño/nombre) autorizado a desplegar con Workload Identity Federation
GITHUB_REPO="gabrielCortesReyes/vota-informado-api"
WIF_POOL="github"
WIF_PROVIDER="github-actions"

# Sincronización del padrón: todos los días a las 05:00 hora de Chile
SYNC_SCHEDULE="0 5 * * *"
SYNC_TIMEZONE="America/Santiago"

# Wikimedia exige identificar la app con una URL o correo de contacto
WIKIPEDIA_USER_AGENT="VotaInformado/3.0 (https://github.com/gabrielCortesReyes/vota-informado-api)"
